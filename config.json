{
  "python": "python",
  "media": {
    "apps": [
      "spotify",
      "applemusic"
    ],
    "allowOtherMediaApps": false
  },
  "notifications": {
    "apps": [
      "YourPhone",
      "Phone Link",
      "Outlook"
    ],
    "ignore": [],
