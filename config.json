  "glass": {
    "opacity": 0.64,
    "blur": 7,
    "saturation": 1.6,
    "everywhere": false
  },
  "lyrics": {
    "enabled": true,
    "dynamic": true,
    "onHover": true,
    "show": false
  },
  "calendars": [],
  "localEvents": [],
  "calendarAlertMinutes": 5,
  "calendar": {
    "weekStartsMonday": true,
    "showDots": true
  },
